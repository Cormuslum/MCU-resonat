# 依赖与构建产物
node_modules/
dist/
_build/

# —— 素材库：媒体文件体积极大（心忆共鸣/public/assets 约 341MB）——
# 但运行时必需的 4 个 JSON 必须保留，否则克隆后模拟器读不到数据：
#   manifest.json            ← src/stores/game.ts 启动时 fetch
#   data/stories.json        ← src/core/museum-stories.ts
#   data/readings.json       ← src/core/museum-readings.ts
#   data/mail-changelog.json ← src/components/MailPopup.vue（信封的版本日志）
# 注意：父目录被整体排除时，子文件的 `!` 规则不生效，
# 所以这里用逐层排除（`public/assets/*` 而非 `public/assets/**`）。
心忆共鸣/public/assets/*
!心忆共鸣/public/assets/manifest.json
!心忆共鸣/public/assets/data/
心忆共鸣/public/assets/data/*
!心忆共鸣/public/assets/data/mail-changelog.json
!心忆共鸣/public/assets/data/stories.json
!心忆共鸣/public/assets/data/readings.json

# 素材源目录（管线输入，约 56GB）
素材/
原始素材/
归档素材/

# 发行版产物（约 2.6GB，内含 237.8MB 的 exe，超 GitHub 单文件 100MB 限制）
release/

# 自带运行时二进制（心忆奇想工坊/运行时 约 133MB，ffmpeg.exe 96MB）
心忆奇想工坊/运行时/

# 截图与临时产物
.shots/
心忆奇想工坊/工具/tools/shots/
心忆奇想工坊/工具/tools/v29*.png
*.log
.tmp-*
.rb-root-*/
vite.config.ts.timestamp-*.mjs
.dev-guard.json
__pycache__/
*.pyc

# 工坊运行时缓存
心忆奇想工坊/工具/updater/.write-cache.json
心忆奇想工坊/工具/updater/.last-apply.json
心忆奇想工坊/工具/updater/.passthrough.json

# 工坊临时目录（源码在 updater/lib 与 updater/web，需精确保留）
心忆奇想工坊/工具/updater/.dist/
心忆奇想工坊/工具/updater/.inbox/
心忆奇想工坊/工具/updater/.snapshots/

# 备份包
备份/

# DLC 扩展包仓库（玩家自己的包，不随源码分发）
DLC仓库/

# 编辑器
.vscode/
.idea/
.DS_Store
Thumbs.db

# AI 助手的开发记忆与红线约定（工具私有工作区，不入库）
.workbuddy/

# 开发期产出的清单与报告（过时且冗余，不入库；归档在本地 开发期文档归档/）
开发期文档归档/

# 开发期文档：界面规格笔记、实机反推的布局坐标表、版本更新日志
# 都不随源码分发，本地保留即可。
notes/
布局坐标/
CHANGELOG.md
